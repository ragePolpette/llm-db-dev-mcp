# Optional local overrides (copy to config.local.env and customize)

DB_DEV_MAX_ROWS=500
DB_DEV_QUERY_TIMEOUT_MS=9000

MCP_DEV_HOST=127.0.0.1
MCP_DEV_PORT=8781
MCP_DEV_PATH=/mcp
MCP_DEV_SSE_ENABLED=false
MCP_DEV_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
MCP_DEV_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,https://localhost:*,https://127.0.0.1:*

MCP_MODELS_DIR=.local/models
