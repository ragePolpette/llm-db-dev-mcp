DB_DEV_CONNECTION_STRING=Server=127.0.0.1;Database=YourDevDb;User Id=your_user;Password=your_password;TrustServerCertificate=True;
DB_DEV_MAX_ROWS=500
# opzionale: se vuoto viene generato random a ogni avvio
DB_DEV_WRITE_CONFIRMATION_TOKEN=
MCP_DEV_HOST=127.0.0.1
MCP_DEV_PORT=8781
MCP_DEV_PATH=/sse

# Reserved local model directory (project-local convention)
MCP_MODELS_DIR=.local/models
